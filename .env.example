# Copy to .env and set your own values. Any OpenAI-compatible provider works.
LLM_BASE_URL=https://api.mistral.ai/v1/chat/completions
LLM_MODEL=mistral-medium-latest
LLM_API_KEY=
LLM_API_KEY_FALLBACK=

# Second provider — automatic failover when quota runs out (401/402/403/429)
LLM_BASE_URL_2=
LLM_MODEL_2=
LLM_API_KEY_2=

# Persistence (PostgresSaver). Compose file provides this automatically.
POSTGRES_DSN=postgresql://postgres:capstone@localhost:5433/hr_agent

# Service auth: endpoints return 503 until these are set (closed by default).
# Two variables on purpose: API_TOKEN opens POST /process (header X-Api-Token),
# APPROVAL_API_TOKEN opens POST /resume (header X-Approval-Token), because
# approving a contract is not the same power as submitting a candidate.
API_TOKEN=
APPROVAL_API_TOKEN=

# Service data root: intake spool, outbox/, reports/, state/. Unset = repo root.
HR_AGENT_ROOT=

# Fixed-window rate limit on the service's write endpoints (per client, per
# endpoint). Unset keeps the built-in default of 20 requests per 60 seconds.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_SECONDS=

# Deterministic offline agents for demos and tests — NO model is called and the
# service warns at start-up when it is on. Leave empty for a real deployment.
HR_AGENT_STUBS=

# Budget guard per case
MAX_LLM_CALLS_PER_CASE=12
LLM_MAX_TOKENS=2000
